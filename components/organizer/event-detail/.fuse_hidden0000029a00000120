'use client'

import { CheckCircle2, Circle, AlertCircle, ArrowRight } from 'lucide-react'
import Link from 'next/link'

interface ChecklistItem {
  id: string
  label: string
  completed: boolean
  href?: string
  ctaText?: string
  priority: 'high' | 'medium' | 'low'
}

interface EventChecklistProps {
  eventId: string
  items: ChecklistItem[]
}

export function EventChecklist({ eventId, items }: EventChecklistProps) {
  const incompleteItems = items.filter(item => !item.completed)
  const completedCount = items.length - incompleteItems.length
  const progress = (completedCount / items.length) * 100

  if (incompleteItems.length === 0) {
    return null
  }

  return (
    <div className="rounded-xl border border-amber-500/30 p-4 md:p-6 shadow-sm">
      <div className="flex items-start justify-between mb-4">
        <div>
          <div className="flex items-center gap-2 mb-1">
            <AlertCircle className="w-5 h-5 text-amber-300" />
            <h3 className="text-lg font-bold text-white">Needs Attention</h3>
          </div>
          <p className="text-sm text-white/60">
            {completedCount} of {items.length} completed
          </p>
        </div>
        <div className="text-right">
          <div className="text-2xl font-bold text-amber-300">{Math.round(progress)}%</div>
          <div className="text-xs text-white/50">Complete</div>
        </div>
      </div>

      {/* Progress Bar */}
      <div className="w-full rounded-full h-2 mb-4 overflow-hidden">
        <div 
          className="h-full bg-amber-500 rounded-full transition-all duration-500"
          style={{ width: `${progress}%` }}
        />
      </div>

      {/* Checklist Items */}
      <div className="space-y-2">
        {incompleteItems.map((item) => (
          <div
            key={item.id}
            className="flex items-center justify-between p-3 bg-[#0a0a0a] rounded-lg border border-amber-500/30 hover:border-amber-300 transition-colors group"
          >
            <div className="flex items-center gap-3 flex-1">
              {item.completed ? (
                <CheckCircle2 className="w-5 h-5 text-green-500 flex-shrink-0" />
              ) : (
                <Circle className={`w-5 h-5 flex-shrink-0 ${
                  item.priority === 'high' ? 'text-red-400' : 
                  item.priority === 'medium' ? 'text-amber-400' : 
                  'text-white/50'
                }`} />
              )}
              <span className="text-sm font-medium text-white">{item.label}</span>
            </div>
            {item.href && (
              <Link
                href={item.href}
                className="flex items-center gap-1 px-3 py-1.5 bg-amber-600 hover:bg-amber-700 text-white text-xs font-medium rounded-lg transition-colors group-hover:shadow-md"
              >
                {item.ctaText || 'Fix'}
                <ArrowRight className="w-3 h-3" />
              </Link>
            )}
          </div>
        ))}
      </div>
    </div>
  )
}
