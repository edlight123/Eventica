{
  "expo": {
    "name": "Tikèm",
    "slug": "tikem",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.tikem.mobile",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:tikem.co",
        "applinks:www.tikem.co"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "co.tikem.mobile",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tikem.co",
              "pathPrefix": "/events"
            },
            {
              "scheme": "https",
              "host": "tikem.co",
              "pathPrefix": "/tickets"
            },
            {
              "scheme": "https",
              "host": "tikem.co",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "tikem.co",
              "pathPrefix": "/notifications"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "tikem",
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Tikèm to access your contacts to find friends who are already on Tikèm. Your contacts are only used to match and are never stored."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b8dc3f81-b1c3-413a-973d-d6587daaa7f0"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b8dc3f81-b1c3-413a-973d-d6587daaa7f0"
    }
  }
}
